# Gateway
PORT=8080
ENGINE_MODE=fake
DEFAULT_MODEL=fake-engine/v1
MAX_RUNNING=16
INTERACTIVE_RESERVE=2
MAX_QUEUED_TOKENS=40000
MAX_QUEUE_WAIT=500ms
MAX_PRE_TTFT_RETRIES=1
TTFT_TARGET=300ms
CACHE_SALT_SECRET=replace-outside-local-development

# Deterministic fake-engine profile
FAKE_TTFT=80ms
FAKE_TPOT=20ms

# Use for llama.cpp or vLLM
# ENGINE_MODE=openai
# UPSTREAM_URL=http://127.0.0.1:8000
# UPSTREAM_API_KEY=
# DEFAULT_MODEL=your-pinned-model-id
